#!/usr/bin/env python
# Builds the GamemoteBle GDExtension.
#   macOS/iOS: CoreBluetooth backend (src/ble_backend_apple.mm)
#   others:    stub backend (reports "unsupported"; used for CI and desktop dev)
# Use build_apple.sh on a Mac; it calls this file for every iOS/macOS slice.

# Only generate bindings for the engine classes we use: much faster godot-cpp builds.
ARGUMENTS.setdefault("build_profile", "build_profile.json")

# Target the Godot 4.5 API: the extension then loads in Godot 4.5, 4.6 and 4.7.
env = SConscript("godot-cpp/SConstruct", {"api_version": "4.5"})
env.Append(CPPPATH=["src/"])

platform = env["platform"]
target = env["target"]
out = "#../../app/addons/gamemote_ble/bin/"
name = "libgamemote_ble"

sources = [File("src/gamemote_ble.cpp"), File("src/register_types.cpp")]

if platform in ("macos", "ios"):
    objc_env = env.Clone()
    # -fmodules + @import makes clang auto-link CoreBluetooth (no Xcode edits needed).
    objc_env.Append(CCFLAGS=["-fobjc-arc", "-fmodules", "-fcxx-modules"])
    build_obj = objc_env.SharedObject if platform == "macos" else objc_env.StaticObject
    sources += build_obj("src/ble_backend_apple.mm")
    if platform == "ios":
        # Godot 4.7.x iOS templates miss two SDL symbols; see src/ios_sdl_compat.mm.
        sources += build_obj("src/ios_sdl_compat.mm")
else:
    sources.append(File("src/ble_backend_stub.cpp"))

if platform == "macos":
    env.Append(LINKFLAGS=["-framework", "CoreBluetooth", "-framework", "Foundation"])
    base = "{}.macos.{}".format(name, target)
    library = env.SharedLibrary("{}{}.framework/{}".format(out, base, base), source=sources)
elif platform == "ios":
    suffix = ".simulator" if env["ios_simulator"] else ""
    library = env.StaticLibrary("{}{}.ios.{}{}.a".format(out, name, target, suffix), source=sources)
else:
    library = env.SharedLibrary("{}{}{}{}".format(out, name, env["suffix"], env["SHLIBSUFFIX"]), source=sources)

env.NoCache(library)
Default(library)
