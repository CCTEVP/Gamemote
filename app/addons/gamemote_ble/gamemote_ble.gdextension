; GamemoteBle native extension. Build the binaries with native/gamemote_ble/build_apple.sh
; (iOS + macOS) or `scons platform=linux` (stub, for CI/desktop development).

[configuration]

entry_symbol = "gamemote_ble_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

ios.debug = "res://addons/gamemote_ble/bin/libgamemote_ble.ios.template_debug.xcframework"
ios.release = "res://addons/gamemote_ble/bin/libgamemote_ble.ios.template_release.xcframework"
macos.debug = "res://addons/gamemote_ble/bin/libgamemote_ble.macos.template_debug.framework"
macos.release = "res://addons/gamemote_ble/bin/libgamemote_ble.macos.template_release.framework"
linux.debug.x86_64 = "res://addons/gamemote_ble/bin/libgamemote_ble.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/gamemote_ble/bin/libgamemote_ble.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/gamemote_ble/bin/libgamemote_ble.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/gamemote_ble/bin/libgamemote_ble.linux.template_release.arm64.so"

[dependencies]

ios.debug = {
  "res://addons/gamemote_ble/bin/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
  "res://addons/gamemote_ble/bin/libgodot-cpp.ios.template_release.xcframework": ""
}
